# Dependencies
node_modules/

# Secrets — config.json may hold API keys (copy config.example.json -> config.json)
config.json

# SQLite databases (regenerated by scripts/seed-demo.js via the python pipeline)
*.db
*.db-journal
*.db-wal
*.db-shm

# Python
__pycache__/
*.pyc

# Runtime data (signatures, exports, uploads)
data/
signatures/

# Logs
logs/
*.log

# Environment / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Generated letters (run the generator to recreate)
letters/output/

# The site mirror under public-site-checkout/ keeps SOURCE in src/data/ —
# it is not runtime data, so it must not be swallowed by the "data/" rule above.
!public-site-checkout/src/data/

# Paid-product download paths. The 48-hex folder tokens under public/downloads/
# are the ONLY thing protecting the paid files, and this repository is PUBLIC.
# The token map lives in the working site (/home/team/shared/site), which is what
# gets published; it must never be committed here. Committing it once published
# every download path to anyone who read the repo.
public-site-checkout/src/lib/purchase.ts
